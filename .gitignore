# Virtual Environments
.venv/
.venv*/
env/
venv/
ENV/

# Large Datasets & Processed Media
dataset/
*.cache

# Training Run Outputs & Large Model Weights
runs/
weights/
*.pt
*.onnx
*.engine
*.tflite

# Runtime Logs
logs/

# Screenshot pairs from the P key (camera + simulator) land directly in report_screenshots/;
# curated figures live in report_screenshots/appendix_A/ and stay tracked
report_screenshots/*.png
report_screenshots/*.jpg

# The trained gesture model is needed at runtime (YOLO commands), so it is committed (21 MB)
!models/gesture_yolo11n_best.pt

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# User & OS Environment Files
.env
.env.local
.DS_Store
Thumbs.db

# Editors, Antigravity & Agent Scratch Directories
.vscode/
.idea/
.gemini/
.claude/

# Per-user calibration profiles (personal, recreated by the 20 s calibration)
simulator/calibration_profiles/
